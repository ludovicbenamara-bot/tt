+
+    els.title = el('div', 'tt-audio-title');
+    els.author = el('div', 'tt-audio-author');
+    info.appendChild(els.title);
+    info.appendChild(els.author);
+
+    // Sound animation: bars with their own speed and height, taller in the middle.
+    els.wave = el('div', 'tt-audio-wave');
+    for (let i = 0; i < WAVE_BARS; i++) {
+        const bar = el('span');
+        const envelope = Math.sin(Math.PI * (i + 0.5) / WAVE_BARS);
+        bar.style.setProperty('--h', (0.25 + 0.75 * envelope * (0.55 + 0.45 * Math.random())).toFixed(2));
