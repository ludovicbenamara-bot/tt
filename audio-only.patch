+    100% { transform: translate(10%, 8%) scale(3.9) rotate(8deg); }
+}
+
+@keyframes tt-audio-drift-2 {
+    0% { transform: translate(12%, 10%) scale(3.9) rotate(180deg); }
+    100% { transform: translate(-12%, -10%) scale(3.4) rotate(200deg); }
+}
+
+/* Burn-in protection (see audioBurnIn.js). */
+.tt-audio-content,
