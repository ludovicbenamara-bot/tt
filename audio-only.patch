+    function targetLevel(band, now) {
+        if (paused) return 0;
+        if (now - beatAt > beatInterval) {
+            beatAt = now;
+            beatInterval = 420 + Math.random() * 180;
+        }
+        const beat = Math.max(0, 1 - (now - beatAt) / 260);
+        const x = band / (BANDS - 1);
+        // Louder lows, a bump in the mids, quieter highs.
+        const envelope = 0.7 - 0.3 * x + 0.12 * Math.sin(x * Math.PI);
+        // Two slow oscillators per band so neighbouring bands drift apart.
+        const wobble = 0.5 + 0.25 * Math.sin(now / (160 + band * 29) + phases[band]) +
+            0.25 * Math.sin(now / (410 + band * 17) - phases[band] * 2);
+        const noise = Math.random();
+        const bassKick = beat * Math.max(0, 1 - x * 1.6) * 0.55;
+        return Math.min(1, envelope * wobble * wobble * 1.3 + noise * noise * 0.3 + bassKick);
+    }
+
+    function draw() {
+        const now = Date.now();
+        // Nothing to draw while hidden (e.g. ambient mode).
+        if (canvas.offsetParent === null) return;
+        resize();
+        const W = canvas.width;
+        const H = canvas.height;
+        if (!W || !H) return;
+
+        const colW = W / BANDS;
+        const baseH = H * 0.06;
+        const rowH = (H - baseH * 2) / ROWS;
+        const cellW = colW * (1 - GAP);
+        const cellH = rowH * (1 - GAP);
+        ctx.clearRect(0, 0, W, H);
+        const live = now - liveAt < LIVE_MAX_AGE_MS ? liveLevels : null;
+
+        for (let b = 0; b < BANDS; b++) {
+            const target = live ? (paused ? 0 : live[b]) : targetLevel(b, now);
+            const k = target > levels[b] ? ATTACK : RELEASE;
+            levels[b] += (target - levels[b]) * k;
+
+            if (levels[b] >= peaks[b]) {
+                peaks[b] = levels[b];
+                peakHeldAt[b] = now;
+            } else if (now - peakHeldAt[b] > PEAK_HOLD_MS) {
+                peaks[b] = Math.max(0, peaks[b] - PEAK_FALL_PER_FRAME);
+            }
+
+            const lit = Math.round(levels[b] * ROWS);
+            const peakRow = Math.min(ROWS - 1, Math.round(peaks[b] * ROWS));
+            const x = b * colW + (colW - cellW) / 2;
+            for (let r = 0; r < ROWS; r++) {
+                const y = H - baseH * 2 - (r + 1) * rowH + (rowH - cellH) / 2;
+                if (r < lit) ctx.fillStyle = rowColors[r];
+                else if (r === peakRow && peaks[b] > 0.04) ctx.fillStyle = COLORS.peak;
+                else ctx.fillStyle = COLORS.off;
+                ctx.fillRect(x, y, cellW, r === peakRow && r >= lit ? cellH * 0.55 : cellH);
+            }
+
+            // Blue dotted baseline, two dots per band.
+            ctx.fillStyle = COLORS.base;
+            const dot = Math.min(baseH, colW * 0.18);
+            ctx.fillRect(x, H - baseH, dot, dot);
+            ctx.fillRect(x + cellW / 2, H - baseH, dot, dot);
+        }
+    }
+
+    return {
+        element: canvas,
+        start() {
+            if (timer) return;
+            timer = setInterval(draw, FRAME_MS);
+            startPolling();
+        },
+        stop() {
+            clearInterval(timer);
+            timer = null;
+            stopPolling();
+        },
+        setPaused(value) {
+            paused = value;
+        },
+        // Take the LED colour from an image that sends CORS headers.
+        // onColor(rgb | null): the LED colour found, for other widgets.
+        setColorFromImage(url, onColor) {
+            const request = ++colorRequest;
+            const img = new Image();
+            img.crossOrigin = 'anonymous';
+            img.onload = () => {
+                if (request !== colorRequest) return;
+                let hue = null;
+                try {
+                    hue = dominantHue(img);
+                } catch (e) { }
+                if (hue === null) {
+                    setGradient(COLORS.low, COLORS.high);
+                    if (onColor) onColor(null);
+                } else {
+                    // Deep at the bottom, bright at the top, like the green original.
+                    setGradient(hslToRgb(hue, 0.72, 0.42), hslToRgb(hue, 0.85, 0.66));
+                    if (onColor) onColor(hslToRgb(hue, 0.9, 0.58));
+                }
+            };
+            img.src = url;
+        },
+    };
+}
diff --git a/mods/features/audioWeather.js b/mods/features/audioWeather.js
new file mode 100644
index 0000000..e6384e6
--- /dev/null
+++ b/mods/features/audioWeather.js
@@ -0,0 +1,303 @@
+// 5-day weather row for the audio-only screen.
+// YouTube TV's CSP only lets the page reach Google/YouTube hosts, so the
+// forecast is relayed through a public Google Sheet: its A1 cell runs
+// IMPORTDATA on Open-Meteo for the location found from the TV's IP,
+// and G1 holds the city name. The sheet is read through the Visualization
+// API, which allows www.youtube.com. Cached for an hour in localStorage.
+
+const SHEET_ID = '1H4rCefkljqqIWs59OCz7jyXSID3uUnaaj3vlhc5prQ0';
+const SHEET_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&headers=0&range=A1:G12`;
+// The modified APK's local server fetches Open-Meteo natively (no CSP, no
+// Google throttling); the sheet is only a fallback for the original APK.
+const NATIVE_URL = 'http://127.0.0.1:47913/weather';
+const CITY_COLUMN = 6;
+// Bumped when the cached data format changes (v2: MeteoSwiss map cities).
+const CACHE_KEY = 'tt-audio-weather-v2';
+const CACHE_TTL_MS = 60 * 60 * 1000;
+// If the sheet cannot reach Open-Meteo (it happens: Google's shared servers
+// get throttled), keep showing the last forecast for up to this long.
+const STALE_MAX_MS = 4 * 24 * 60 * 60 * 1000;
+const REQUEST_TIMEOUT_MS = 8000;
+const DAYS = 5;
+const SVG_NS = 'http://www.w3.org/2000/svg';
+
+const COLORS = {
+    sun: '#FFC83D',
+    sunRay: '#FFAA00',
+    cloud: '#F2F6FA',
+    cloudShade: '#C9D3DD',
+    darkCloud: '#9BA7B4',
+    rain: '#4AA8FF',
+    snow: '#DDF1FF',
+    bolt: '#FFD43B',
+    fog: '#D5DCE3',
+};
+
+function el(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text) node.textContent = text;
+    return node;
+}
+
+function svgEl(tag, attrs) {
+    const node = document.createElementNS(SVG_NS, tag);
+    for (const key in attrs) node.setAttribute(key, attrs[key]);
+    return node;
+}
+
+function sun(cx, cy, r, rays) {
+    const g = svgEl('g', {});
+    if (rays) {
+        const d = [];
+        for (let i = 0; i < 8; i++) {
+            const a = (Math.PI / 4) * i;
+            const x1 = cx + Math.cos(a) * (r + 3), y1 = cy + Math.sin(a) * (r + 3);
+            const x2 = cx + Math.cos(a) * (r + 7), y2 = cy + Math.sin(a) * (r + 7);
+            d.push(`M${x1.toFixed(1)} ${y1.toFixed(1)}L${x2.toFixed(1)} ${y2.toFixed(1)}`);
+        }
+        g.appendChild(svgEl('path', { d: d.join(''), stroke: COLORS.sunRay, 'stroke-width': 3, 'stroke-linecap': 'round', fill: 'none' }));
+    }
+    g.appendChild(svgEl('circle', { cx, cy, r, fill: COLORS.sun }));
+    return g;
+}
+
+function cloud(dx, dy, fill) {
+    const g = svgEl('g', { transform: `translate(${dx} ${dy})` });
+    g.appendChild(svgEl('path', {
+        d: 'M13 38h23a8 8 0 0 0 .9-15.95A11.5 11.5 0 0 0 14.6 20 9 9 0 0 0 13 38z',
+        fill: fill || COLORS.cloud,
+    }));
+    g.appendChild(svgEl('path', {
+        d: 'M13 38h23a8 8 0 0 0 7.6-5.5A8 8 0 0 1 36 36H13a9 9 0 0 1-8.6-6.2A9 9 0 0 0 13 38z',
+        fill: COLORS.cloudShade,
+        opacity: 0.6,
+    }));
+    return g;
+}
+
+function lines(d, color, width) {
+    return svgEl('path', { d, stroke: color, 'stroke-width': width || 3, 'stroke-linecap': 'round', fill: 'none' });
+}
+
+// WMO weather codes -> icon kind.
+export function kindFor(code) {
+    if (code === 0) return 'clear';
+    if (code === 1 || code === 2) return 'partly';
+    if (code === 3) return 'cloudy';
+    if (code === 45 || code === 48) return 'fog';
+    if ((code >= 71 && code <= 77) || code === 85 || code === 86) return 'snow';
+    if (code >= 95) return 'storm';
+    if (code >= 51) return 'rain';
+    return 'cloudy';
+}
+
+export function weatherIcon(kind) {
+    const svg = svgEl('svg', { viewBox: '0 0 48 48', class: 'tt-audio-weather-icon' });
+    switch (kind) {
+        case 'clear':
+            svg.appendChild(sun(24, 24, 9, true));
+            break;
+        case 'partly':
+            svg.appendChild(sun(17, 17, 7.5, true));
+            svg.appendChild(cloud(4, 3));
+            break;
+        case 'cloudy':
+            svg.appendChild(cloud(-4, -6, COLORS.cloudShade));
+            svg.appendChild(cloud(2, 1));
+            break;
+        case 'fog':
+            svg.appendChild(cloud(0, -6));
+            svg.appendChild(lines('M8 39h32M12 44h24', COLORS.fog));
+            break;
+        case 'rain':
+            svg.appendChild(cloud(0, -6));
+            svg.appendChild(lines('M17 37l-2.5 6M25 37l-2.5 6M33 37l-2.5 6', COLORS.rain));
+            break;
+        case 'snow':
+            svg.appendChild(cloud(0, -6));
+            for (const [cx, cy] of [[15, 40], [24, 44], [33, 40]]) {
+                svg.appendChild(svgEl('circle', { cx, cy, r: 2.6, fill: COLORS.snow }));
+            }
+            break;
+        case 'storm':
+            svg.appendChild(cloud(0, -7, COLORS.darkCloud));
+            svg.appendChild(svgEl('path', { d: 'M26 29l-7 10h5.5l-3 8 10-12.5h-5.5l3-5.5z', fill: COLORS.bolt }));
+            break;
+    }
+    return svg;
+}
+
+function fetchText(url) {
+    let timer;
+    const timeout = new Promise((_, reject) => {
+        timer = setTimeout(() => reject(new Error('timeout')), REQUEST_TIMEOUT_MS);
+    });
+    const request = fetch(url).then((r) => {
+        if (!r.ok) throw new Error('HTTP ' + r.status);
+        return r.text();
+    });
+    return Promise.race([request, timeout]).then((data) => {
+        clearTimeout(timer);
+        return data;
+    }, (e) => {
+        clearTimeout(timer);
+        throw e;
+    });
+}
+
+function readCache(maxAge) {
+    try {
+        const cached = JSON.parse(window.localStorage.getItem(CACHE_KEY));
+        if (cached && Date.now() - cached.savedAt < maxAge) return cached;
+    } catch (e) { }
+    return null;
+}
+
+function localIsoDate(date) {
+    const pad = (n) => (n < 10 ? '0' : '') + n;
+    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
+}
+
+// Old forecasts start in the past: drop the days before today.
+function fromToday(data) {
+    const today = localIsoDate(new Date());
+    const days = data.days.filter((day) => day.date >= today);
+    return days.length ? Object.assign({}, data, { days }) : null;
+}
+
+function writeCache(data) {
+    try {
+        window.localStorage.setItem(CACHE_KEY, JSON.stringify(data));
+    } catch (e) { }
+}
+
+// Spreadsheet serial day (days since 1899-12-30) or "Date(y,m,d)" -> "YYYY-MM-DD".
+function toIsoDate(value) {
+    let date = null;
+    if (typeof value === 'number' && value > 40000 && value < 80000) {
+        date = new Date(Date.UTC(1899, 11, 30) + Math.round(value) * 86400000);
+    } else if (typeof value === 'string') {
+        const m = value.match(/^Date\((\d+),(\d+),(\d+)/);
+        if (m) date = new Date(Date.UTC(+m[1], +m[2], +m[3]));
+        else if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
+    }
+    return date ? date.toISOString().slice(0, 10) : null;
+}
+
+function cellValue(row, index) {
+    const cell = row && row.c && row.c[index];
+    return cell ? cell.v : null;
+}
+
+async function loadForecast() {
+    const cached = readCache(CACHE_TTL_MS);
+    if (cached) return fromToday(cached) || fetchForecast();
+    try {
+        return await fetchForecast();
+    } catch (e) {
+        const stale = readCache(STALE_MAX_MS);
+        const usable = stale && fromToday(stale);
+        if (usable) return usable;
+        throw e;
+    }
+}
+
+async function fetchNativeForecast() {
+    const json = JSON.parse(await fetchText(NATIVE_URL));
+    const days = (json && json.days || []).filter((d) =>
+        d && typeof d.date === 'string' && typeof d.code === 'number' &&
+        typeof d.max === 'number' && typeof d.min === 'number');
+    if (!days.length) throw new Error('no native forecast');
+    // Cities for the Swiss map (MeteoSwiss), when the native side has them.
+    const cities = Array.isArray(json.cities) ? json.cities : [];
+    const data = { savedAt: Date.now(), city: '', days: days.slice(0, DAYS), cities };
+    writeCache(data);
+    return data;
+}
+
+async function fetchForecast() {
+    try {
+        return await fetchNativeForecast();
+    } catch (e) {
+        return fetchSheetForecast();
+    }
+}
+
+async function fetchSheetForecast() {
+    const text = await fetchText(SHEET_URL);
+    const json = JSON.parse(text.slice(text.indexOf('(') + 1, text.lastIndexOf(')')));
+    const rows = json && json.table && json.table.rows;
+    if (!rows) throw new Error('no sheet data');
+
+    let city = '';
+    const days = [];
+    for (const row of rows) {
+        const cityCell = cellValue(row, CITY_COLUMN);
+        if (!city && typeof cityCell === 'string') city = cityCell;
+        const date = toIsoDate(cellValue(row, 0));
+        const code = cellValue(row, 1);
+        const max = cellValue(row, 2);
+        const min = cellValue(row, 3);
+        if (date && typeof code === 'number' && typeof max === 'number' && typeof min === 'number') {
+            days.push({ date, code, max: Math.round(max), min: Math.round(min) });
+        }
+    }
+    if (!days.length) throw new Error('no forecast');
+
+    const data = { savedAt: Date.now(), city, days: days.slice(0, DAYS) };
+    writeCache(data);
+    return data;
+}
+
+function dayLabel(date, index, todayLabel) {
+    if (index === 0) return todayLabel;
+    // Parse as local noon so the weekday is right in every time zone.
+    const d = new Date(date + 'T12:00:00');
+    try {
+        const label = d.toLocaleDateString(navigator.language || undefined, { weekday: 'short' });
+        return label.charAt(0).toUpperCase() + label.slice(1).replace(/\.$/, '');
+    } catch (e) {
+        return ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][d.getDay()];
+    }
+}
+
+function render(container, data, todayLabel) {
+    while (container.firstChild) container.removeChild(container.firstChild);
+    data.days.forEach((day, i) => {
+        const item = el('div', 'tt-audio-weather-day');
+        item.appendChild(el('div', 'tt-audio-weather-label', dayLabel(day.date, i, todayLabel)));
+        item.appendChild(weatherIcon(kindFor(day.code)));
+        const temps = el('div', 'tt-audio-weather-temps');
+        // min | max, like the MeteoSwiss map labels.
+        temps.appendChild(el('span', 'tt-audio-weather-min', day.min + '°'));
+        temps.appendChild(el('span', 'tt-audio-weather-max', day.max + '°'));
+        item.appendChild(temps);
+        container.appendChild(item);
+    });
+    container.style.display = '';
+}
+
+// Creates the weather row; it stays hidden until a forecast is available.
+export function createWeather(todayLabel, onData) {
+    const container = el('div', 'tt-audio-weather');
+    container.style.display = 'none';
+    let lastRefresh = 0;
+
+    function refresh() {
+        if (Date.now() - lastRefresh < CACHE_TTL_MS) return;
+        lastRefresh = Date.now();
+        loadForecast()
+            .then((data) => {
+                render(container, data, todayLabel);
+                if (onData) onData(data);
+            })
+            .catch((e) => {
+                // Try again sooner after a failure (network not ready yet, etc.).
+                lastRefresh = Date.now() - CACHE_TTL_MS + 5 * 60 * 1000;
+                console.info('[AudioOnly] weather unavailable:', e && e.message);
+            });
+    }
+
+    return { element: container, refresh };
+}
