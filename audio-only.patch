+    next: ['M35.5 9H40v30h-4.5z', 'M7 10.6v26.8c0 1.5 1.6 2.4 2.9 1.6l21.7-13.4c1.2-.8 1.2-2.5 0-3.3L9.9 9C8.6 8.2 7 9.1 7 10.6z'],
