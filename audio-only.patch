+// Audio-only mode for TizenTube
+// Hides the video behind a "now playing" screen. Remote: OK = play/pause,
+// Left/Right = seek 10s, Back = leave audio mode.
+
+import { t } from 'i18next';
+import css from './audioOnly.css';
+import { createWeather, weatherIcon, kindFor } from './audioWeather.js';
+import { createClock } from './audioClock.js';
+import { createBurnInGuard } from './audioBurnIn.js';
+
+const SEEK_STEP = 10;
+// Channel up/down on the remote: Starboard key codes, Android's raw key codes,
+// plus PageUp/PageDown that some remotes send instead.
+const NEXT_KEYS = [427, 166, 33];
+const PREVIOUS_KEYS = [428, 167, 34];
+// Media keys YouTube TV already understands; we replay them to change track.
+const MEDIA_NEXT_KEY = 176;
+const MEDIA_PREVIOUS_KEY = 177;
+// "Previous" restarts the track when we are past this point, like Apple Music.
+const RESTART_THRESHOLD_S = 3;
+const BACK_KEYS = [8, 27, 461, 10009];
+const VIDEO_ID_RE = /^[\w-]{11}$/;
