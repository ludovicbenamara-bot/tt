diff --git a/mods/features/audioBurnIn.js b/mods/features/audioBurnIn.js
new file mode 100644
index 0000000..2dfe900
--- /dev/null
+++ b/mods/features/audioBurnIn.js
@@ -0,0 +1,127 @@
+// Screen burn-in protection for the audio-only screen. Three levels:
+//  1. Pixel shift (always on): the whole layout drifts a few pixels along a
+//     Lissajous curve, so no pixel shows the same thing for long.
+//  2. Dim: after DIM_AFTER_MS without a remote key, static UI fades down.
+//  3. Ambient: after AMBIENT_AFTER_MS, only artwork, title and clock remain on
+//     a near-black screen, and that block moves to a new place regularly.
+// The first key after level 2 or 3 only wakes the screen.
+
+export const DIM_AFTER_MS = 3 * 60 * 1000;
+export const AMBIENT_AFTER_MS = 10 * 60 * 1000;
+const SHIFT_INTERVAL_MS = 60 * 1000;
+// About 12 px on a 1080p screen.
+const SHIFT_AMPLITUDE_VH = 1.1;
+const AMBIENT_MOVE_INTERVAL_MS = 30 * 1000;
+const AMBIENT_FADE_MS = 1200;
+// How far the ambient block may wander from the centre.
+const AMBIENT_RANGE_VW = 22;
+const AMBIENT_RANGE_VH = 20;
+
+export function createBurnInGuard(overlay, content, footer, timings) {
+    const dimAfter = (timings && timings.dimAfter) || DIM_AFTER_MS;
+    const ambientAfter = (timings && timings.ambientAfter) || AMBIENT_AFTER_MS;
+    const shiftInterval = (timings && timings.shiftInterval) || SHIFT_INTERVAL_MS;
+    const ambientMoveInterval = (timings && timings.ambientMoveInterval) || AMBIENT_MOVE_INTERVAL_MS;
+
+    let lastActivity = Date.now();
+    let shiftStep = 0;
+    let lastShiftAt = 0;
+    let shift = { x: 0, y: 0 };
+    let ambientOffset = { x: 0, y: 0 };
+    let lastAmbientMoveAt = 0;
+    let moveTimer = null;
+
+    function applyTransforms() {
+        content.style.transform = `translate(calc(${shift.x}vh + ${ambientOffset.x}vw), calc(${shift.y}vh + ${ambientOffset.y}vh))`;
+        footer.style.transform = `translate(${shift.x}vh, ${shift.y}vh)`;
+    }
+
+    function nextShift() {
+        shiftStep++;
+        // Different frequencies on each axis trace a figure that covers the area.
+        shift = {
+            x: +(SHIFT_AMPLITUDE_VH * Math.sin(shiftStep * 0.7)).toFixed(2),
+            y: +(SHIFT_AMPLITUDE_VH * Math.sin(shiftStep * 1.1)).toFixed(2),
+        };
+        applyTransforms();
+    }
+
+    function moveAmbientBlock() {
+        clearTimeout(moveTimer);
+        overlay.classList.add('tt-audio-ambient-moving');
+        moveTimer = setTimeout(() => {
+            ambientOffset = {
+                x: +((Math.random() * 2 - 1) * AMBIENT_RANGE_VW).toFixed(1),
+                y: +((Math.random() * 2 - 1) * AMBIENT_RANGE_VH).toFixed(1),
+            };
+            content.style.transition = 'none';
+            applyTransforms();
+            // Force the jump to happen before transitions come back.
+            void content.offsetWidth;
+            content.style.removeProperty('transition');
+            overlay.classList.remove('tt-audio-ambient-moving');
+        }, AMBIENT_FADE_MS);
+    }
+
+    function leaveAmbient() {
+        clearTimeout(moveTimer);
+        overlay.classList.remove('tt-audio-ambient', 'tt-audio-ambient-moving');
+        if (ambientOffset.x || ambientOffset.y) {
+            ambientOffset = { x: 0, y: 0 };
+            content.style.transition = 'none';
+            applyTransforms();
+            void content.offsetWidth;
+            content.style.removeProperty('transition');
+        }
+    }
+
+    function isIdle() {
+        return overlay.classList.contains('tt-audio-dim') || overlay.classList.contains('tt-audio-ambient');
+    }
+
+    return {
+        // Call on every remote key. Returns true if the screen was dimmed or in
+        // ambient mode: that key should then only wake the screen.
+        wake() {
+            const wasIdle = isIdle();
+            lastActivity = Date.now();
+            if (wasIdle) {
+                overlay.classList.remove('tt-audio-dim');
+                leaveAmbient();
+            }
+            return wasIdle;
+        },
+
+        // Call regularly (the audio screen ticks every 500 ms).
+        tick() {
+            const now = Date.now();
+            const idle = now - lastActivity;
+
+            if (now - lastShiftAt >= shiftInterval) {
+                lastShiftAt = now;
+                nextShift();
+            }
+
+            overlay.classList.toggle('tt-audio-dim', idle >= dimAfter && idle < ambientAfter);
+
+            if (idle >= ambientAfter) {
+                if (!overlay.classList.contains('tt-audio-ambient')) {
+                    overlay.classList.add('tt-audio-ambient');
+                    lastAmbientMoveAt = 0;
+                }
+                if (now - lastAmbientMoveAt >= ambientMoveInterval) {
+                    lastAmbientMoveAt = now;
+                    moveAmbientBlock();
+                }
+            }
+        },
+
+        // Call when the audio screen opens.
+        reset() {
+            lastActivity = Date.now();
+            lastShiftAt = Date.now();
+            overlay.classList.remove('tt-audio-dim');
+            leaveAmbient();
+        },
+    };
+}
diff --git a/mods/features/audioClock.js b/mods/features/audioClock.js
new file mode 100644
index 0000000..fb236f6
--- /dev/null
+++ b/mods/features/audioClock.js
@@ -0,0 +1,121 @@
+// Widget-style clock for the audio-only screen: a dark rounded card with
+// minute ticks around the edge, analog hands in the middle, the hours and
+// minutes in large digits on each side, the date above and today's weather
+// below (same look as the Android "dual clock" widget).
+
+const SVG_NS = 'http://www.w3.org/2000/svg';
+// The SVG uses the card's aspect ratio; CSS sizes the card.
+const VIEW_W = 200;
+const VIEW_H = 104;
+const CX = VIEW_W / 2;
+const CY = VIEW_H / 2;
+const TICK_INSET = 5;
+const ACCENT = '#3B7BFF';
+
+function el(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text) node.textContent = text;
+    return node;
+}
+
+function svgEl(tag, attrs) {
+    const node = document.createElementNS(SVG_NS, tag);
+    for (const key in attrs) node.setAttribute(key, attrs[key]);
+    return node;
+}
+
+// 60 ticks pointing at the centre, ending on the card's (inset) border.
+function buildTicks(svg) {
+    const halfW = VIEW_W / 2 - TICK_INSET;
+    const halfH = VIEW_H / 2 - TICK_INSET;
+    for (let i = 0; i < 60; i++) {
+        const a = (Math.PI * 2 * i) / 60;
+        const dx = Math.sin(a);
+        const dy = -Math.cos(a);
+        const t = Math.min(Math.abs(dx) > 1e-6 ? halfW / Math.abs(dx) : Infinity,
+            Math.abs(dy) > 1e-6 ? halfH / Math.abs(dy) : Infinity);
+        const major = i % 5 === 0;
+        const len = major ? 11 : 6;
+        svg.appendChild(svgEl('line', {
+            x1: (CX + dx * t).toFixed(2), y1: (CY + dy * t).toFixed(2),
+            x2: (CX + dx * (t - len)).toFixed(2), y2: (CY + dy * (t - len)).toFixed(2),
+            stroke: major ? 'rgba(255,255,255,0.9)' : 'rgba(255,255,255,0.28)',
+            'stroke-width': major ? 1.4 : 0.9,
+            'stroke-linecap': 'round',
+        }));
+    }
+}
+
+function hand(length, width, color, tail) {
+    return svgEl('line', {
+        x1: CX, y1: CY + (tail || 0), x2: CX, y2: CY - length,
+        stroke: color, 'stroke-width': width, 'stroke-linecap': 'round',
+    });
+}
+
+export function createClock() {
+    const card = el('div', 'tt-audio-clock');
+
+    const svg = svgEl('svg', { viewBox: `0 0 ${VIEW_W} ${VIEW_H}`, class: 'tt-audio-clock-face' });
+    buildTicks(svg);
+    const hourHand = hand(17, 3.4, '#F2F2F2');
+    const minuteHand = hand(27, 3, '#F2F2F2');
+    const secondHand = hand(33, 1, ACCENT, 7);
+    svg.appendChild(hourHand);
+    svg.appendChild(minuteHand);
+    svg.appendChild(secondHand);
+    svg.appendChild(svgEl('circle', { cx: CX, cy: CY, r: 3.4, fill: '#F2F2F2' }));
+    svg.appendChild(svgEl('circle', { cx: CX, cy: CY, r: 1.8, fill: ACCENT }));
+    card.appendChild(svg);
+
+    const date = el('div', 'tt-audio-clock-date');
+    const dayMonth = el('span');
+    const weekday = el('span', 'tt-audio-clock-weekday');
+    date.appendChild(dayMonth);
+    date.appendChild(weekday);
+    card.appendChild(date);
+
+    const hours = el('div', 'tt-audio-clock-digits tt-audio-clock-hours');
+    const minutes = el('div', 'tt-audio-clock-digits tt-audio-clock-minutes');
+    card.appendChild(hours);
+    card.appendChild(minutes);
+
+    const weather = el('div', 'tt-audio-clock-weather');
+    weather.style.display = 'none';
+    card.appendChild(weather);
+
+    const pad = (n) => (n < 10 ? '0' : '') + n;
+    const lang = navigator.language || undefined;
+
+    function update() {
+        const now = new Date();
+        const h = now.getHours();
+        const m = now.getMinutes();
+        const s = now.getSeconds();
+        hours.textContent = pad(h);
+        minutes.textContent = pad(m);
+        hourHand.setAttribute('transform', `rotate(${((h % 12) + m / 60) * 30} ${CX} ${CY})`);
+        minuteHand.setAttribute('transform', `rotate(${(m + s / 60) * 6} ${CX} ${CY})`);
+        secondHand.setAttribute('transform', `rotate(${s * 6} ${CX} ${CY})`);
+        try {
+            dayMonth.textContent = now.toLocaleDateString(lang, { day: 'numeric', month: 'short' }) + ' ';
+            weekday.textContent = now.toLocaleDateString(lang, { weekday: 'short' });
+        } catch (e) {
+            dayMonth.textContent = pad(now.getDate()) + '/' + pad(now.getMonth() + 1) + ' ';
+            weekday.textContent = '';
+        }
+    }
+
+    // icon: an SVG element, label: e.g. "Couvert", temp: e.g. 10.
+    function setWeather(icon, label, temp) {
+        while (weather.firstChild) weather.removeChild(weather.firstChild);
+        icon.setAttribute('class', 'tt-audio-clock-weather-icon');
+        weather.appendChild(icon);
+        weather.appendChild(el('span', '', `${label} ${temp}°`));
+        weather.style.display = '';
+    }
+
+    update();
+    return { element: card, update, setWeather };
+}
diff --git a/mods/features/audioOnly.css b/mods/features/audioOnly.css
new file mode 100644
index 0000000..ee8c2ea
--- /dev/null
+++ b/mods/features/audioOnly.css
@@ -0,0 +1,534 @@
+/* Audio-only "Now Playing" screen, styled after Apple Music on Apple TV. */
+
+.tt-audio {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100vw;
+    height: 100vh;
+    z-index: 2147483000;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    overflow: hidden;
+    background: #000;
+    color: #fff;
+    font-family: -apple-system, 'SF Pro Display', 'Helvetica Neue', 'YouTube Sans', Roboto, Arial, sans-serif;
+    -webkit-font-smoothing: antialiased;
+}
+
+/* Animated, heavily blurred artwork behind everything. The layer is blurred
+   at a small size and scaled up, which is far cheaper for TV GPUs. */
+.tt-audio-backdrop {
+    position: absolute;
+    top: 30%;
+    left: 30%;
+    width: 40%;
+    height: 40%;
+    background-size: cover;
+    background-position: center;
+    filter: blur(24px) saturate(1.8) brightness(0.75);
+    opacity: 0.95;
+    animation: tt-audio-drift 28s ease-in-out infinite alternate;
+}
+
+.tt-audio-backdrop-2 {
+    opacity: 0.5;
+    animation: tt-audio-drift-2 36s ease-in-out infinite alternate;
+}
+
+.tt-audio-shade {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    background:
+        radial-gradient(ellipse at 30% 50%, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.35) 70%),
+        linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.45) 100%);
+}
+
+.tt-audio-clock {
+    /* Every size inside the card is in em, so the card scales from font-size. */
+    font-size: 1vh;
+    position: relative;
+    width: 52em;
+    height: 27.04em;
+    margin-bottom: 2.5vh;
+    border-radius: 4.2em;
+    background: rgba(28, 28, 30, 0.92);
+    box-shadow: 0 1.5em 4em rgba(0, 0, 0, 0.4);
+    overflow: hidden;
+    color: #fff;
+}
+
+.tt-audio-clock-face {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+}
+
+.tt-audio-clock-date {
+    position: absolute;
+    top: 19%;
+    left: 0;
+    right: 0;
+    text-align: center;
+    font-size: 2.5em;
+    font-weight: 600;
+    color: rgba(255, 255, 255, 0.85);
+}
+
+.tt-audio-clock-weekday {
+    color: #3B7BFF;
+}
+
+.tt-audio-clock-digits {
+    position: absolute;
+    top: 50%;
+    width: 38%;
+    font-size: 9.4em;
+    font-weight: 700;
+    line-height: 1;
+    font-variant-numeric: tabular-nums;
+    letter-spacing: -0.02em;
+    transform: translateY(-50%);
+}
+
+.tt-audio-clock-hours {
+    right: 59%;
+    text-align: right;
+}
+
+.tt-audio-clock-minutes {
+    left: 59%;
+    text-align: left;
+}
+
+.tt-audio-clock-weather {
+    position: absolute;
+    bottom: 17%;
+    left: 0;
+    right: 0;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-size: 2.5em;
+    font-weight: 600;
+    color: rgba(255, 255, 255, 0.85);
+}
+
+.tt-audio-clock-weather-icon {
+    width: 1.5em;
+    height: 1.5em;
+    margin-right: 0.35em;
+}
+
+.tt-audio-content {
+    position: relative;
+    display: flex;
+    align-items: center;
+    width: 86vw;
+}
+
+/* Large artwork; shrinks a little when paused, like Apple Music. */
+.tt-audio-art-wrap {
+    flex: 0 0 auto;
+    margin-right: 6vw;
+}
+
+.tt-audio-art {
+    width: 52vh;
+    height: 52vh;
+    border-radius: 2.2vh;
+    background-color: rgba(255, 255, 255, 0.08);
+    background-size: cover;
+    background-position: center;
+    box-shadow: 0 4vh 10vh rgba(0, 0, 0, 0.55), 0 1vh 3vh rgba(0, 0, 0, 0.35);
+    transform: scale(1);
+    transition: transform 0.6s cubic-bezier(0.34, 1.4, 0.64, 1), box-shadow 0.6s ease;
+}
+
+/* hqdefault thumbnails are 4:3 with letterbox bars; zoom them off. */
+.tt-audio-art-letterboxed {
+    background-size: auto 134%;
+}
+
+.tt-audio-paused .tt-audio-art {
+    transform: scale(0.86);
+    box-shadow: 0 2vh 5vh rgba(0, 0, 0, 0.4);
+}
+
+.tt-audio-info {
+    flex: 1 1 auto;
+    min-width: 0;
+    max-width: 52vw;
+}
+
+/* 5-day weather row above the title. */
+.tt-audio-weather {
+    display: flex;
+    align-items: flex-end;
+    margin-bottom: 3.5vh;
+}
+
+.tt-audio-weather-day {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    width: 9vh;
+    margin-right: 1.8vh;
+    padding: 1.2vh 0 1vh;
+    border-radius: 1.6vh;
+    background: rgba(255, 255, 255, 0.08);
+}
+
+.tt-audio-weather-day:first-child {
+    background: rgba(255, 255, 255, 0.16);
+}
+
+.tt-audio-weather-label {
+    font-size: 1.8vh;
+    font-weight: 600;
+    color: rgba(255, 255, 255, 0.75);
+}
+
+.tt-audio-weather-icon {
+    width: 6.4vh;
+    height: 6.4vh;
+    margin: 0.6vh 0;
+    filter: drop-shadow(0 0.4vh 0.8vh rgba(0, 0, 0, 0.25));
+}
+
+.tt-audio-weather-temps {
+    font-size: 1.9vh;
+    font-weight: 700;
+    font-variant-numeric: tabular-nums;
+}
+
+.tt-audio-weather-min {
+    margin-left: 0.6vh;
+    font-weight: 500;
+    color: rgba(255, 255, 255, 0.55);
+}
+
+.tt-audio-weather-city {
+    align-self: center;
+    margin-left: 1vh;
+    font-size: 2vh;
+    font-weight: 600;
+    color: rgba(255, 255, 255, 0.6);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.tt-audio-title {
+    font-size: 5vh;
+    font-weight: 700;
+    line-height: 1.12;
+    letter-spacing: -0.02em;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    overflow: hidden;
+}
+
+.tt-audio-author {
+    margin-top: 1vh;
+    font-size: 3.4vh;
+    font-weight: 500;
+    color: rgba(255, 255, 255, 0.62);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+/* Sound animation. */
+.tt-audio-wave {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    height: 9vh;
+    margin: 4.5vh 0 3.5vh;
+}
+
+.tt-audio-wave span {
+    flex: 0 0 auto;
+    width: 0.55vh;
+    height: 100%;
+    border-radius: 0.3vh;
+    background: rgba(255, 255, 255, 0.85);
+    transform: scaleY(0.12);
+    animation-name: tt-audio-wave;
+    animation-timing-function: ease-in-out;
+    animation-iteration-count: infinite;
+    animation-direction: alternate;
+}
+
+.tt-audio-paused .tt-audio-wave span {
+    animation-play-state: paused;
+    opacity: 0.35;
+}
+
+.tt-audio-bar {
+    position: relative;
+    height: 0.8vh;
+    border-radius: 0.4vh;
+    background: rgba(255, 255, 255, 0.22);
+    overflow: hidden;
+    cursor: pointer;
+}
+
+.tt-audio-fill {
+    height: 100%;
+    width: 0;
+    border-radius: 0.4vh;
+    background: rgba(255, 255, 255, 0.92);
+    transition: width 0.5s linear;
+}
+
+.tt-audio-times {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-top: 1.4vh;
+    font-size: 2vh;
+    font-weight: 600;
+    font-variant-numeric: tabular-nums;
+    color: rgba(255, 255, 255, 0.55);
+}
+
+.tt-audio-badge {
+    padding: 0.4vh 1.2vh;
+    border-radius: 0.6vh;
+    background: rgba(255, 255, 255, 0.14);
+    font-size: 1.5vh;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+    color: rgba(255, 255, 255, 0.75);
+}
+
+.tt-audio-controls {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    margin-top: 4vh;
+}
+
+.tt-audio-btn {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 10vh;
+    height: 10vh;
+    margin: 0 2.2vh;
+    padding: 0;
+    border: none;
+    border-radius: 50%;
+    background: transparent;
+    color: #fff;
+    cursor: pointer;
+    outline: none;
+}
+
+.tt-audio-icon {
+    width: 6vh;
+    height: 6vh;
+    fill: currentColor;
+}
+
+.tt-audio-icon text {
+    font-size: 13px;
+    font-weight: 700;
+    font-family: inherit;
+    fill: currentColor;
+}
+
+.tt-audio-btn-track .tt-audio-icon {
+    width: 4.6vh;
+    height: 4.6vh;
+}
+
+.tt-audio-btn {
+    transition: transform 0.15s ease, background-color 0.15s ease;
+}
+
+.tt-audio-btn-pressed {
+    transform: scale(0.88);
+    background-color: rgba(255, 255, 255, 0.22);
+}
+
+.tt-audio-btn-main {
+    width: 13vh;
+    height: 13vh;
+    background: rgba(255, 255, 255, 0.16);
+}
+
+.tt-audio-btn-main .tt-audio-icon {
+    width: 7vh;
+    height: 7vh;
+}
+
+.tt-audio-footer {
+    position: absolute;
+    left: 0;
+    right: 0;
+    bottom: 4.5vh;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.tt-audio-hint {
+    font-size: 1.8vh;
+    color: rgba(255, 255, 255, 0.45);
+}
+
+.tt-audio-exit {
+    margin-left: 3vh;
+    padding: 1vh 2.4vh;
+    border: none;
+    border-radius: 999px;
+    background: rgba(255, 255, 255, 0.14);
+    color: rgba(255, 255, 255, 0.85);
+    font-family: inherit;
+    font-size: 1.8vh;
+    font-weight: 600;
+    cursor: pointer;
+    outline: none;
+}
+
+@keyframes tt-audio-blink {
+    50% { opacity: 0.25; }
+}
+
+@keyframes tt-audio-wave {
+    from { transform: scaleY(0.12); }
+    to { transform: scaleY(var(--h, 0.8)); }
+}
+
+@keyframes tt-audio-drift {
