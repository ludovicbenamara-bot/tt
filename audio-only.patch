+}
+
+function nextTrack() {
+    changeTrack(MEDIA_NEXT_KEY, 'nextVideo');
+}
+
+function previousTrack() {
+    const video = getVideo();
+    if (video && video.currentTime > RESTART_THRESHOLD_S) {
+        flashButton(els.previous);
+        video.currentTime = 0;
+        updateProgress();
+        return;
+    }
+    changeTrack(MEDIA_PREVIOUS_KEY, 'previousVideo');
