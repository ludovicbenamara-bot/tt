diff --git a/mods/features/audioBurnIn.js b/mods/features/audioBurnIn.js
new file mode 100644
index 0000000..2dfe900
--- /dev/null
+++ b/mods/features/audioBurnIn.js
@@ -0,0 +1,127 @@
+// Screen burn-in protection for the audio-only screen. Three levels:
+//  1. Pixel shift (always on): the whole layout drifts a few pixels along a
+//     Lissajous curve, so no pixel shows the same thing for long.
+//  2. Dim: after DIM_AFTER_MS without a remote key, static UI fades down.
+//  3. Ambient: after AMBIENT_AFTER_MS, only artwork, title and clock remain on
+//     a near-black screen, and that block moves to a new place regularly.
+// The first key after level 2 or 3 only wakes the screen.
+
+export const DIM_AFTER_MS = 3 * 60 * 1000;
+export const AMBIENT_AFTER_MS = 10 * 60 * 1000;
+const SHIFT_INTERVAL_MS = 60 * 1000;
+// About 12 px on a 1080p screen.
+const SHIFT_AMPLITUDE_VH = 1.1;
+const AMBIENT_MOVE_INTERVAL_MS = 30 * 1000;
+const AMBIENT_FADE_MS = 1200;
+// How far the ambient block may wander from the centre.
+const AMBIENT_RANGE_VW = 22;
+const AMBIENT_RANGE_VH = 20;
+
+export function createBurnInGuard(overlay, content, footer, timings) {
+    const dimAfter = (timings && timings.dimAfter) || DIM_AFTER_MS;
+    const ambientAfter = (timings && timings.ambientAfter) || AMBIENT_AFTER_MS;
+    const shiftInterval = (timings && timings.shiftInterval) || SHIFT_INTERVAL_MS;
+    const ambientMoveInterval = (timings && timings.ambientMoveInterval) || AMBIENT_MOVE_INTERVAL_MS;
+
+    let lastActivity = Date.now();
+    let shiftStep = 0;
+    let lastShiftAt = 0;
+    let shift = { x: 0, y: 0 };
+    let ambientOffset = { x: 0, y: 0 };
+    let lastAmbientMoveAt = 0;
+    let moveTimer = null;
+
+    function applyTransforms() {
+        content.style.transform = `translate(calc(${shift.x}vh + ${ambientOffset.x}vw), calc(${shift.y}vh + ${ambientOffset.y}vh))`;
+        footer.style.transform = `translate(${shift.x}vh, ${shift.y}vh)`;
+    }
+
+    function nextShift() {
+        shiftStep++;
+        // Different frequencies on each axis trace a figure that covers the area.
+        shift = {
+            x: +(SHIFT_AMPLITUDE_VH * Math.sin(shiftStep * 0.7)).toFixed(2),
+            y: +(SHIFT_AMPLITUDE_VH * Math.sin(shiftStep * 1.1)).toFixed(2),
+        };
+        applyTransforms();
+    }
+
+    function moveAmbientBlock() {
+        clearTimeout(moveTimer);
+        overlay.classList.add('tt-audio-ambient-moving');
+        moveTimer = setTimeout(() => {
+            ambientOffset = {
+                x: +((Math.random() * 2 - 1) * AMBIENT_RANGE_VW).toFixed(1),
+                y: +((Math.random() * 2 - 1) * AMBIENT_RANGE_VH).toFixed(1),
+            };
+            content.style.transition = 'none';
+            applyTransforms();
+            // Force the jump to happen before transitions come back.
+            void content.offsetWidth;
+            content.style.removeProperty('transition');
+            overlay.classList.remove('tt-audio-ambient-moving');
+        }, AMBIENT_FADE_MS);
+    }
+
+    function leaveAmbient() {
+        clearTimeout(moveTimer);
+        overlay.classList.remove('tt-audio-ambient', 'tt-audio-ambient-moving');
+        if (ambientOffset.x || ambientOffset.y) {
+            ambientOffset = { x: 0, y: 0 };
+            content.style.transition = 'none';
+            applyTransforms();
+            void content.offsetWidth;
+            content.style.removeProperty('transition');
+        }
+    }
+
+    function isIdle() {
+        return overlay.classList.contains('tt-audio-dim') || overlay.classList.contains('tt-audio-ambient');
+    }
+
+    return {
+        // Call on every remote key. Returns true if the screen was dimmed or in
+        // ambient mode: that key should then only wake the screen.
+        wake() {
+            const wasIdle = isIdle();
+            lastActivity = Date.now();
+            if (wasIdle) {
+                overlay.classList.remove('tt-audio-dim');
+                leaveAmbient();
+            }
+            return wasIdle;
+        },
+
+        // Call regularly (the audio screen ticks every 500 ms).
+        tick() {
+            const now = Date.now();
+            const idle = now - lastActivity;
+
+            if (now - lastShiftAt >= shiftInterval) {
+                lastShiftAt = now;
+                nextShift();
+            }
+
+            overlay.classList.toggle('tt-audio-dim', idle >= dimAfter && idle < ambientAfter);
+
+            if (idle >= ambientAfter) {
+                if (!overlay.classList.contains('tt-audio-ambient')) {
+                    overlay.classList.add('tt-audio-ambient');
+                    lastAmbientMoveAt = 0;
+                }
+                if (now - lastAmbientMoveAt >= ambientMoveInterval) {
+                    lastAmbientMoveAt = now;
+                    moveAmbientBlock();
+                }
+            }
+        },
+
+        // Call when the audio screen opens.
+        reset() {
+            lastActivity = Date.now();
+            lastShiftAt = Date.now();
+            overlay.classList.remove('tt-audio-dim');
+            leaveAmbient();
+        },
+    };
+}
diff --git a/mods/features/audioHue.js b/mods/features/audioHue.js
new file mode 100644
index 0000000..3760d73
--- /dev/null
+++ b/mods/features/audioHue.js
@@ -0,0 +1,152 @@
+// Philips Hue ambiance: every time a new video starts (audio mode or not),
+// the Hue strip is turned on in the artwork's dominant colour. The APK's
+// local server talks to the Hue Bridge; the bridge address and key are set
+// up once on the TV and are not part of this script.
+// The audio screen shows a Hue-app style tile (on/off, brightness) that uses
+// the `hue` controller exported here. When the user switches the strip off,
+// it stays off (new videos don't turn it back on) until switched on again.
+
+import { colorFromImage } from './audioSpectrum.js';
+
+const HUE_URL = 'http://127.0.0.1:47913/hue';
+const CHECK_MS = 2000;
+const VIDEO_ID_RE = /^[\w-]{11}$/;
+// Colour for artwork without a clear hue: warm white.
+const NEUTRAL_RGB = [255, 214, 170];
+const PREFS_KEY = 'tt-hue-prefs';
+const BRI_MIN = 3;
+const BRI_MAX = 254;
+const BRI_STEP = 25;
+// Brightness presses are grouped before being sent to the bridge.
+const BRI_SEND_DELAY_MS = 300;
+// The bridge takes a moment to report a change it has just applied.
+const REFRESH_AFTER_MS = 1500;
+
+let lastVideoId = null;
+let briTimer = null;
+const listeners = [];
+
+// Per-TV preferences: { off: bool, bri: 0 (automatic) or 1-254 }.
+function loadPrefs() {
+    try {
+        const prefs = JSON.parse(localStorage.getItem(PREFS_KEY) || '{}');
+        return { off: !!prefs.off, bri: Number(prefs.bri) || 0 };
+    } catch (e) {
+        return { off: false, bri: 0 };
+    }
+}
+const prefs = loadPrefs();
+
+function savePrefs() {
+    try {
+        localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
+    } catch (e) { }
+}
+
+// configured: null until known; reachable: false when the bridge did not answer.
+const state = { configured: null, reachable: true, on: !prefs.off, bri: prefs.bri, name: '', rgb: null };
+
+function notify() {
+    for (const fn of listeners) {
+        try {
+            fn(state);
+        } catch (e) { }
+    }
+}
+
+function call(path) {
+    return fetch(HUE_URL + path, { cache: 'no-store' }).then((r) => r.text());
+}
+
+function refresh() {
+    return call('/state').then((text) => {
+        const data = JSON.parse(text);
+        state.configured = !!data.configured;
+        state.reachable = !data.error && data.reachable !== false;
+        if (data.error) return notify();
+        if (typeof data.on === 'boolean') state.on = data.on;
+        if (data.bri) state.bri = data.bri;
+        if (data.name) state.name = data.name;
+        notify();
+    }).catch(() => {
+        // No local server (simulation or older APK): hide the tile.
+        state.configured = false;
+        notify();
+    });
+}
+
+function refreshSoon() {
+    setTimeout(refresh, REFRESH_AFTER_MS);
+}
+
+function sendColor() {
+    const [r, g, b] = state.rgb || NEUTRAL_RGB;
+    return call(`?r=${r}&g=${g}&b=${b}&bri=${prefs.bri}`).then(refreshSoon, () => { });
+}
+
+function setOn(on) {
+    prefs.off = !on;
+    savePrefs();
+    state.on = on;
+    notify();
+    if (on) sendColor();
+    else call('/off').then(refreshSoon, () => { });
+}
+
+function stepBrightness(direction) {
+    if (!state.on) return;
+    const current = state.bri || prefs.bri || BRI_MAX;
+    const bri = Math.max(BRI_MIN, Math.min(BRI_MAX, current + direction * BRI_STEP));
+    if (bri === state.bri) return;
+    state.bri = bri;
+    prefs.bri = bri;
+    savePrefs();
+    notify();
+    clearTimeout(briTimer);
+    briTimer = setTimeout(sendColor, BRI_SEND_DELAY_MS);
+}
+
+export const hue = {
+    state,
+    refresh,
+    toggle() {
+        setOn(!state.on);
+    },
+    setOn,
+    stepBrightness,
+    // fn(state) on every change; returns nothing (the screen lives as long as the page).
+    subscribe(fn) {
+        listeners.push(fn);
+        fn(state);
+    },
+    // Brightness as a percentage, the way the Hue app shows it.
+    percent() {
+        return Math.max(1, Math.round(((state.bri || BRI_MAX) / BRI_MAX) * 100));
+    },
+};
+
+function currentVideoId() {
+    const player = document.querySelector('.html5-video-player');
+    try {
+        const data = player && player.getVideoData ? player.getVideoData() : null;
+        return data && data.video_id;
+    } catch (e) {
+        return null;
+    }
+}
+
+function check() {
+    const videoId = currentVideoId();
+    if (!videoId || videoId === lastVideoId || !VIDEO_ID_RE.test(videoId)) return;
+    const video = document.querySelector('video');
+    if (!video || video.paused) return;
+    lastVideoId = videoId;
+    colorFromImage(`https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`, (rgb) => {
+        state.rgb = rgb || NEUTRAL_RGB;
+        notify();
+        // Switched off by the user: keep it off.
+        if (!prefs.off) sendColor();
+    });
+}
+
+setInterval(check, CHECK_MS);
diff --git a/mods/features/audioHueTile.js b/mods/features/audioHueTile.js
new file mode 100644
index 0000000..5a2a954
--- /dev/null
+++ b/mods/features/audioHueTile.js
@@ -0,0 +1,99 @@
+// Hue-app style light tile for the audio screen: bulb icon, light name,
+// state and brightness, an on/off switch, and a brightness bar along the
+// bottom. The tile takes the light's colour while it is on.
+// Remote (see audioOnly.js): Down selects it, OK switches the light,
+// Left/Right change the brightness, Up or Back leave it.
+
+import { t } from 'i18next';
+import { hue } from './audioHue.js';
+
+const SVG_NS = 'http://www.w3.org/2000/svg';
+const BULB = [
+    'M24 5a13.5 13.5 0 0 0-8 24.4c1.3 1 2 2.4 2 4V35h12v-1.6c0-1.6.7-3 2-4A13.5 13.5 0 0 0 24 5z',
+    'M18 38h12v3H18z',
+    'M20 43h8v.8a2.2 2.2 0 0 1-2.2 2.2h-3.6a2.2 2.2 0 0 1-2.2-2.2z',
+];
+
+function el(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text) node.textContent = text;
+    return node;
+}
+
+function bulbIcon() {
+    const svg = document.createElementNS(SVG_NS, 'svg');
+    svg.setAttribute('viewBox', '0 0 48 48');
+    svg.setAttribute('class', 'tt-hue-icon');
+    for (const d of BULB) {
+        const path = document.createElementNS(SVG_NS, 'path');
+        path.setAttribute('d', d);
+        svg.appendChild(path);
+    }
+    return svg;
+}
+
+export function createHueTile() {
+    const tile = el('button', 'tt-hue');
+    const iconWrap = el('div', 'tt-hue-icon-wrap');
+    iconWrap.appendChild(bulbIcon());
+    const text = el('div', 'tt-hue-text');
+    const name = el('div', 'tt-hue-name');
+    const status = el('div', 'tt-hue-status');
+    text.appendChild(name);
+    text.appendChild(status);
+    const toggle = el('div', 'tt-hue-switch');
+    toggle.appendChild(el('div', 'tt-hue-knob'));
+    const briTrack = el('div', 'tt-hue-bri');
+    const briFill = el('div', 'tt-hue-bri-fill');
+    briTrack.appendChild(briFill);
+    tile.appendChild(iconWrap);
+    tile.appendChild(text);
+    tile.appendChild(toggle);
+    tile.appendChild(briTrack);
+    tile.addEventListener('click', () => hue.toggle());
+
+    let focused = false;
+
+    function render(state) {
+        tile.style.display = state.configured ? '' : 'none';
+        name.textContent = state.name || t('player.audioOnly.hueName');
+        const on = state.on && state.reachable;
+        tile.classList.toggle('tt-hue-on', on);
+        if (!state.reachable) status.textContent = t('player.audioOnly.hueUnreachable');
+        else status.textContent = on ? t('player.audioOnly.hueOn', { bri: hue.percent() }) : t('player.audioOnly.hueOff');
+        briFill.style.width = on ? `${hue.percent()}%` : '0';
+        const [r, g, b] = state.rgb || [255, 214, 170];
+        // The Hue app paints the tile in the light's colour, fading to the right.
+        tile.style.background = on
+            ? `linear-gradient(90deg, rgba(${r}, ${g}, ${b}, 0.92) 0%, rgba(${r}, ${g}, ${b}, 0.5) 100%)`
+            : '';
+        iconWrap.style.color = on ? `rgb(${r}, ${g}, ${b})` : '';
+    }
+
+    hue.subscribe(render);
+
+    return {
+        element: tile,
+        // Asks the bridge for the light's real state (on/off, brightness).
+        refresh() {
+            hue.refresh();
+        },
+        isAvailable() {
+            return !!hue.state.configured;
+        },
+        isFocused() {
+            return focused;
+        },
+        setFocused(value) {
+            focused = !!value && !!hue.state.configured;
+            tile.classList.toggle('tt-hue-focused', focused);
+        },
+        toggle() {
+            hue.toggle();
+        },
+        stepBrightness(direction) {
+            hue.stepBrightness(direction);
+        },
+    };
+}
diff --git a/mods/features/audioLedClock.js b/mods/features/audioLedClock.js
new file mode 100644
index 0000000..7a7a925
--- /dev/null
+++ b/mods/features/audioLedClock.js
@@ -0,0 +1,195 @@
+// LED dot-matrix clock, like a station / studio wall clock: the time in large
+// dot digits on the left, then a ring of 60 dots lit up to the current second
+// (with the seconds inside), and the date (weekday, day, month) on the right.
+// The LEDs take the artwork's colour (red until one is set).
+// Drawn on a canvas: one dot per pixel of a 5x7 font.
+
+const DEFAULT_RGB = [255, 59, 42];
+
+// 5x7 font, one string per row ('1' = dot on).
+const FONT = {
+    '0': ['01110', '10001', '10011', '10101', '11001', '10001', '01110'],
+    '1': ['00100', '01100', '00100', '00100', '00100', '00100', '01110'],
+    '2': ['01110', '10001', '00001', '00010', '00100', '01000', '11111'],
+    '3': ['11111', '00010', '00100', '00010', '00001', '10001', '01110'],
+    '4': ['00010', '00110', '01010', '10010', '11111', '00010', '00010'],
+    '5': ['11111', '10000', '11110', '00001', '00001', '10001', '01110'],
+    '6': ['00110', '01000', '10000', '11110', '10001', '10001', '01110'],
+    '7': ['11111', '00001', '00010', '00100', '01000', '01000', '01000'],
+    '8': ['01110', '10001', '10001', '01110', '10001', '10001', '01110'],
+    '9': ['01110', '10001', '10001', '01111', '00001', '00010', '01100'],
+    'A': ['01110', '10001', '10001', '11111', '10001', '10001', '10001'],
+    'B': ['11110', '10001', '10001', '11110', '10001', '10001', '11110'],
+    'C': ['01110', '10001', '10000', '10000', '10000', '10001', '01110'],
+    'D': ['11110', '10001', '10001', '10001', '10001', '10001', '11110'],
+    'E': ['11111', '10000', '10000', '11110', '10000', '10000', '11111'],
+    'F': ['11111', '10000', '10000', '11110', '10000', '10000', '10000'],
+    'G': ['01110', '10001', '10000', '10111', '10001', '10001', '01111'],
+    'H': ['10001', '10001', '10001', '11111', '10001', '10001', '10001'],
+    'I': ['01110', '00100', '00100', '00100', '00100', '00100', '01110'],
+    'J': ['00111', '00010', '00010', '00010', '00010', '10010', '01100'],
+    'K': ['10001', '10010', '10100', '11000', '10100', '10010', '10001'],
+    'L': ['10000', '10000', '10000', '10000', '10000', '10000', '11111'],
+    'M': ['10001', '11011', '10101', '10101', '10001', '10001', '10001'],
+    'N': ['10001', '10001', '11001', '10101', '10011', '10001', '10001'],
+    'O': ['01110', '10001', '10001', '10001', '10001', '10001', '01110'],
+    'P': ['11110', '10001', '10001', '11110', '10000', '10000', '10000'],
+    'Q': ['01110', '10001', '10001', '10001', '10101', '10010', '01101'],
+    'R': ['11110', '10001', '10001', '11110', '10100', '10010', '10001'],
+    'S': ['01111', '10000', '10000', '01110', '00001', '00001', '11110'],
+    'T': ['11111', '00100', '00100', '00100', '00100', '00100', '00100'],
+    'U': ['10001', '10001', '10001', '10001', '10001', '10001', '01110'],
+    'V': ['10001', '10001', '10001', '10001', '10001', '01010', '00100'],
+    'W': ['10001', '10001', '10001', '10101', '10101', '10101', '01010'],
+    'X': ['10001', '10001', '01010', '00100', '01010', '10001', '10001'],
+    'Y': ['10001', '10001', '10001', '01010', '00100', '00100', '00100'],
+    'Z': ['11111', '00001', '00010', '00100', '01000', '10000', '11111'],
+    ':': ['0', '0', '1', '0', '1', '0', '0'],
+    // Blank of the colon's width, so the minutes don't move when it blinks.
+    ';': ['0', '0', '0', '0', '0', '0', '0'],
+    ' ': ['000', '000', '000', '000', '000', '000', '000'],
+};
+
+const DAYS = {
+    fr: ['DIM', 'LUN', 'MAR', 'MER', 'JEU', 'VEN', 'SAM'],
+    en: ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'],
+};
+const MONTHS = {
+    fr: ['JANV', 'FEVR', 'MARS', 'AVR', 'MAI', 'JUIN', 'JUIL', 'AOUT', 'SEPT', 'OCT', 'NOV', 'DEC'],
+    en: ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
+};
+
+function textWidth(text) {
+    let cols = 0;
+    for (const ch of text) cols += (FONT[ch] || FONT[' '])[0].length + 1;
+    return Math.max(0, cols - 1);
+}
+
+export function createLedClock() {
+    const card = document.createElement('div');
+    card.className = 'tt-audio-led';
+    const canvas = document.createElement('canvas');
+    canvas.className = 'tt-audio-led-canvas';
+    card.appendChild(canvas);
+    const ctx = canvas.getContext('2d');
+    const lang = String(navigator.language || 'fr').toLowerCase().startsWith('fr') ? 'fr' : 'en';
+    let lastKey = '';
+    let LIT;
+    let UNLIT;
+    let GLOW;
+
+    function setColor(rgb) {
+        const [r, g, b] = rgb;
+        LIT = `rgb(${r}, ${g}, ${b})`;
+        UNLIT = `rgba(${r}, ${g}, ${b}, 0.12)`;
+        GLOW = `rgba(${r}, ${g}, ${b}, 0.55)`;
+        lastKey = '';
+    }
+    setColor(DEFAULT_RGB);
+
+    function dot(x, y, r, on) {
+        ctx.beginPath();
+        ctx.arc(x, y, r, 0, Math.PI * 2);
+        ctx.fillStyle = on ? LIT : UNLIT;
+        ctx.fill();
+    }
+
+    // Draws text with its top-left at (x, y); `pitch` is the dot spacing.
+    function drawText(text, x, y, pitch, lit) {
+        ctx.shadowColor = GLOW;
+        ctx.shadowBlur = lit ? pitch * 0.9 : 0;
+        let cx = x;
+        for (const ch of text) {
+            const glyph = FONT[ch] || FONT[' '];
+            for (let row = 0; row < 7; row++) {
+                for (let col = 0; col < glyph[row].length; col++) {
+                    const on = glyph[row][col] === '1';
+                    if (!on && !lit) continue;
+                    if (on) dot(cx + col * pitch + pitch / 2, y + row * pitch + pitch / 2, pitch * 0.36, lit !== false);
+                }
+            }
+            cx += (glyph[0].length + 1) * pitch;
+        }
+        ctx.shadowBlur = 0;
+    }
+
+    function draw(now) {
+        const ratio = window.devicePixelRatio || 1;
+        const W = Math.round(canvas.clientWidth * ratio);
+        const H = Math.round(canvas.clientHeight * ratio);
+        if (!W || !H) return;
+        if (canvas.width !== W || canvas.height !== H) {
+            canvas.width = W;
+            canvas.height = H;
+        }
+        ctx.clearRect(0, 0, W, H);
+
+        const pad = (n) => (n < 10 ? '0' : '') + n;
+        const h = pad(now.getHours());
+        const m = pad(now.getMinutes());
+        const s = now.getSeconds();
+        const colonOn = s % 2 === 0;
+        const timeText = h + (colonOn ? ':' : ';') + m;
+
+        // Date on the right: weekday, day number, month (3 rows of dots).
+        const datePitch = H * 0.04;
+        const day = String(now.getDate());
+        const weekday = DAYS[lang][now.getDay()];
+        const month = MONTHS[lang][now.getMonth()];
+        const rows = [weekday, day, month];
+        const dateW = Math.max(...rows.map(textWidth)) * datePitch;
+        const right = W - H * 0.04;
+        const rowH = 8.5 * datePitch;
+        const top = (H - rows.length * rowH + 1.5 * datePitch) / 2;
+        rows.forEach((text, i) => {
+            drawText(text, right - textWidth(text) * datePitch, top + i * rowH, datePitch, true);
+        });
+
+        // Time on the left, as large as fits before the seconds ring.
+        const ringR = H * 0.42;
+        const ringD = ringR * 2 + H * 0.05;
+        const left = H * 0.06;
+        const gap = H * 0.2;
+        const space = right - dateW - gap - ringD - gap - left;
+        const cols = textWidth('88:88');
+        const timePitch = Math.min(H * 0.105, space / cols);
+        const timeW = cols * timePitch;
+        // Centre the time + ring group in the room left of the date.
+        const spare = space - timeW;
+        const timeLeft = left + spare / 2;
+        const timeTop = (H - 7 * timePitch) / 2;
+        drawText(h + ':' + m, timeLeft, timeTop, timePitch, false);
+        drawText(timeText, timeLeft, timeTop, timePitch, true);
+
+        // Seconds ring right after the time.
+        const ringCx = timeLeft + timeW + gap + ringD / 2;
+        const ringCy = H * 0.5;
+        for (let i = 0; i < 60; i++) {
+            const a = (i / 60) * Math.PI * 2 - Math.PI / 2;
+            const big = i % 5 === 0;
+            ctx.shadowColor = GLOW;
+            ctx.shadowBlur = i <= s ? H * 0.02 : 0;
+            dot(ringCx + Math.cos(a) * ringR, ringCy + Math.sin(a) * ringR, H * (big ? 0.022 : 0.015), i <= s);
+        }
+        ctx.shadowBlur = 0;
+        const secPitch = H * 0.06;
+        const secText = pad(s);
+        drawText(secText, ringCx - textWidth(secText) * secPitch / 2, ringCy - 3.5 * secPitch, secPitch, true);
+    }
+
+    return {
+        element: card,
+        // rgb: [r, g, b] (0-255), or null for the default red.
+        setColor(rgb) {
+            setColor(rgb || DEFAULT_RGB);
+        },
+        // Called twice a second by the audio screen; redraws when the second changes.
+        update() {
+            const now = new Date();
+            const key = now.getSeconds() + ':' + canvas.clientWidth;
+            if (key === lastKey) return;
+            lastKey = key;
+            draw(now);
+        },
+    };
+}
