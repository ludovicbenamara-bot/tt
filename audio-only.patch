+// Audio-only mode for TizenTube
+// Hides the video behind a "now playing" screen. Remote: OK = play/pause,
+// Left/Right = seek 10s, Back = leave audio mode, Down = Hue tile.
+
+import { t } from 'i18next';
+import css from './audioOnly.css';
+import { createWeather, weatherIcon, kindFor } from './audioWeather.js';
+import { createSpectrum } from './audioSpectrum.js';
+import { createSwissMap } from './audioMap.js';
+import { createLedClock } from './audioLedClock.js';
+import { createBurnInGuard } from './audioBurnIn.js';
+import { createHueTile } from './audioHueTile.js';
+
+const SEEK_STEP = 10;
+// Channel up/down on the remote: Starboard key codes, Android's raw key codes,
+// plus PageUp/PageDown that some remotes send instead.
+const NEXT_KEYS = [427, 166, 33];
+const PREVIOUS_KEYS = [428, 167, 34];
+// Media keys YouTube TV already understands; we replay them to change track.
+const MEDIA_NEXT_KEY = 176;
+const MEDIA_PREVIOUS_KEY = 177;
+// "Previous" restarts the track when we are past this point, like Apple Music.
+const RESTART_THRESHOLD_S = 3;
+const BACK_KEYS = [8, 27, 461, 10009];
+const VIDEO_ID_RE = /^[\w-]{11}$/;
+// The player briefly reports no video while it reloads; only leave audio mode
+// after it has been gone for this many ticks (500 ms each).
+const MAX_MISSING_TICKS = 4;
+// The YouTube button can fire its command more than once per press.
+const TOGGLE_DEBOUNCE_MS = 600;
+// Re-read the Hue light's state now and then (it may be changed from the Hue app).
+const HUE_REFRESH_TICKS = 60;
+
+window.isAudioOnly = false;
+
+let overlay = null;
+let els = {};
+let tickInterval = null;
+let lastVideoId = null;
+let missingTicks = 0;
+let lastToggleAt = 0;
+let hueTicks = 0;
+
+function log(...args) {
+    console.info('[AudioOnly]', ...args);
+}
+
+function getPlayer() {
+    return document.querySelector('.html5-video-player');
+}
+
+function getVideo() {
+    return document.querySelector('video');
+}
+
+function formatTime(seconds) {
+    if (!isFinite(seconds) || seconds < 0) seconds = 0;
+    seconds = Math.floor(seconds);
+    const h = Math.floor(seconds / 3600);
+    const m = Math.floor((seconds % 3600) / 60);
+    const s = seconds % 60;
+    const pad = (n) => (n < 10 ? '0' : '') + n;
+    return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
+}
+
+function el(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text) node.textContent = text;
+    return node;
+}
+
+// SVG built with DOM calls: YouTube TV enforces Trusted Types, so innerHTML is off limits.
+const SVG_NS = 'http://www.w3.org/2000/svg';
+function svgIcon(className, paths, label) {
+    const svg = document.createElementNS(SVG_NS, 'svg');
+    svg.setAttribute('viewBox', '0 0 48 48');
+    svg.setAttribute('class', className);
+    for (const d of paths) {
+        const path = document.createElementNS(SVG_NS, 'path');
+        path.setAttribute('d', d);
+        svg.appendChild(path);
+    }
+    if (label) {
+        const text = document.createElementNS(SVG_NS, 'text');
+        text.setAttribute('x', '24');
+        text.setAttribute('y', '30');
+        text.setAttribute('text-anchor', 'middle');
+        text.textContent = label;
+        svg.appendChild(text);
+    }
+    return svg;
+}
+
+const ICONS = {
