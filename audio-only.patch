+
+function el(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text) node.textContent = text;
+    return node;
+}
+
+export function createSwissMap() {
+    const card = el('div', 'tt-audio-map');
+    card.style.display = 'none';
+
+    // Drawn on a canvas: Cobalt's SVG renderer leaves artefacts on large paths.
+    const canvas = document.createElement('canvas');
+    canvas.className = 'tt-audio-map-shape';
+    card.appendChild(canvas);
+    let drawnWidth = 0;
+
+    function drawShape() {
+        const ratio = window.devicePixelRatio || 1;
+        const w = Math.round(canvas.clientWidth * ratio);
+        const h = Math.round(canvas.clientHeight * ratio);
+        if (!w || !h || w === drawnWidth) return;
+        drawnWidth = w;
+        canvas.width = w;
+        canvas.height = h;
+        const ctx = canvas.getContext('2d');
+        ctx.setTransform(w / MAP.width, 0, 0, h / MAP.height, 0, 0);
+        const land = new Path2D(BORDER);
+        ctx.fillStyle = '#79b49c';
+        ctx.fill(land);
+        ctx.lineWidth = 1.5;
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
+        ctx.stroke(land);
+        ctx.fillStyle = '#8ec3f5';
+        ctx.fill(new Path2D(LAKES));
+    }
+
+    const labels = el('div', 'tt-audio-map-labels');
+    card.appendChild(labels);
+
+    // cities: [{name, x, y (LV95), code (WMO), min, max}]
+    function setCities(cities) {
+        while (labels.firstChild) labels.removeChild(labels.firstChild);
+        if (!cities || !cities.length) {
+            card.style.display = 'none';
+            return;
+        }
+        for (const c of cities) {
+            if (typeof c.x !== 'number' || typeof c.y !== 'number') continue;
+            const marker = el('div', 'tt-audio-map-city');
+            // Near the right edge, put the label above the icon (Austria side, free).
+            if ((c.x - MAP.x0) / (MAP.x1 - MAP.x0) > 0.88) marker.classList.add('tt-audio-map-city-above');
+            marker.style.left = ((c.x - MAP.x0) / (MAP.x1 - MAP.x0) * 100).toFixed(2) + '%';
+            marker.style.top = ((MAP.y1 - c.y) / (MAP.y1 - MAP.y0) * 100).toFixed(2) + '%';
+            const icon = weatherIcon(kindFor(c.code));
+            icon.setAttribute('class', 'tt-audio-map-icon');
+            marker.appendChild(icon);
+            const pill = el('div', 'tt-audio-map-pill');
+            pill.appendChild(el('div', 'tt-audio-map-name', String(c.name || '')));
+            const temps = el('div', 'tt-audio-map-temps');
+            temps.appendChild(el('span', '', c.min + '°'));
+            temps.appendChild(el('span', '', c.max + '°'));
+            pill.appendChild(temps);
+            marker.appendChild(pill);
+            labels.appendChild(marker);
+        }
+        card.style.display = '';
+        // Needs the card laid out to know its size.
+        setTimeout(drawShape, 0);
+    }
+
+    return { element: card, setCities };
+}
diff --git a/mods/features/audioOnly.css b/mods/features/audioOnly.css
new file mode 100644
index 0000000..7af5545
--- /dev/null
+++ b/mods/features/audioOnly.css
@@ -0,0 +1,704 @@
+/* Audio-only "Now Playing" screen, styled after Apple Music on Apple TV. */
+
+.tt-audio {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100vw;
+    height: 100vh;
+    z-index: 2147483000;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    overflow: hidden;
+    background: #000;
+    color: #fff;
+    font-family: -apple-system, 'SF Pro Display', 'Helvetica Neue', 'YouTube Sans', Roboto, Arial, sans-serif;
+    -webkit-font-smoothing: antialiased;
+}
+
+/* Animated, heavily blurred artwork behind everything. The layer is blurred
+   at a small size and scaled up, which is far cheaper for TV GPUs. */
+.tt-audio-backdrop {
+    position: absolute;
+    top: 30%;
+    left: 30%;
+    width: 40%;
+    height: 40%;
+    background-size: cover;
+    background-position: center;
+    filter: blur(24px) saturate(1.8) brightness(0.75);
+    opacity: 0.95;
+    animation: tt-audio-drift 28s ease-in-out infinite alternate;
+}
+
+.tt-audio-backdrop-2 {
+    opacity: 0.5;
+    animation: tt-audio-drift-2 36s ease-in-out infinite alternate;
+}
+
+.tt-audio-shade {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    background:
+        radial-gradient(ellipse at 30% 50%, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.35) 70%),
+        linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.45) 100%);
+}
+
+.tt-audio-led {
+    box-sizing: border-box;
+    width: 62vh;
+    height: 17vh;
+    margin-bottom: 2vh;
+    padding: 1.2vh 1.6vh;
+    border-radius: 2.2vh;
+    background: rgba(8, 8, 10, 0.88);
+    box-shadow: 0 2vh 5vh rgba(0, 0, 0, 0.4), inset 0 0 0 0.15vh rgba(255, 255, 255, 0.06);
+}
+
+.tt-audio-led-canvas {
+    display: block;
+    width: 100%;
+    height: 100%;
+}
+
+.tt-audio-content {
+    position: relative;
+    display: flex;
+    /* Both columns share the same height: the player starts level with the
+       weather card and ends level with the bottom of the map. */
+    align-items: stretch;
+    width: 86vw;
+}
+
+/* Large artwork; shrinks a little when paused, like Apple Music. */
+.tt-audio-art-wrap {
+    flex: 0 0 auto;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    margin-right: 5vw;
+}
+
+.tt-audio-art {
+    flex: 0 0 auto;
+    width: 21vh;
+    height: 21vh;
+    margin-right: 3vh;
+    border-radius: 1.8vh;
+    background-color: rgba(255, 255, 255, 0.08);
+    background-size: cover;
+    background-position: center;
+    box-shadow: 0 1.5vh 4vh rgba(0, 0, 0, 0.5);
+    transform: scale(1);
+    transition: transform 0.6s cubic-bezier(0.34, 1.4, 0.64, 1), box-shadow 0.6s ease;
+}
+
+/* hqdefault thumbnails are 4:3 with letterbox bars; zoom them off. */
+.tt-audio-art-letterboxed {
+    background-size: auto 134%;
+}
+
+.tt-audio-paused .tt-audio-art {
+    transform: scale(0.86);
+    box-shadow: 0 2vh 5vh rgba(0, 0, 0, 0.4);
+}
+
+.tt-audio-title-row {
+    display: flex;
+    align-items: center;
+    /* Free height goes above the title: the whole player sits low, ending
+       level with the bottom of the map. */
+    margin-top: auto;
+}
+
+.tt-audio-title-text {
+    flex: 1 1 auto;
+    min-width: 0;
+}
+
+/* Swiss weather map (MeteoSwiss data), where the large artwork used to be. */
+.tt-audio-map {
+    position: relative;
+    width: 62vh;
+    height: calc(62vh * 646 / 1000);
+    border-radius: 2.2vh;
+    background: rgba(34, 40, 48, 0.72);
+    box-shadow: 0 2vh 5vh rgba(0, 0, 0, 0.35);
+    overflow: hidden;
+}
+
+.tt-audio-map-shape {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+}
+
+.tt-audio-map-labels {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+}
+
+/* Anchored on the city: icon on the point, label to its right. */
+.tt-audio-map-city {
+    position: absolute;
+    display: flex;
+    align-items: center;
+    transform: translate(-1.9vh, -50%);
+    white-space: nowrap;
+}
+
+.tt-audio-map-city-above {
+    flex-direction: column-reverse;
+    transform: translate(-50%, calc(-100% + 1.9vh));
+}
+
+.tt-audio-map-city-above .tt-audio-map-icon {
+    margin: -0.5vh 0 0;
+}
+
+.tt-audio-map-icon {
+    margin-right: 0;
+    margin-left: -0.6vh;
+}
+
+.tt-audio-map-city-left .tt-audio-map-pill {
+    padding: 0.35vh 1.1vh 0.4vh 0.9vh;
+}
+
+.tt-audio-map-icon {
+    width: 3.8vh;
+    height: 3.8vh;
