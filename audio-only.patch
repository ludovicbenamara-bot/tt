+}
+
+.tt-audio-ambient .tt-audio-content {
+    width: auto;
+}
+
+.tt-audio-ambient .tt-audio-art-wrap {
+    margin-right: 4vh;
+}
+
+.tt-audio-ambient .tt-audio-art {
+    width: 30vh;
+    height: 30vh;
+}
+
+.tt-audio-ambient .tt-audio-clock {
+    font-size: 0.577vh;
+    margin-bottom: 1.5vh;
+}
+
+.tt-audio-ambient .tt-audio-info {
+    max-width: 36vw;
+}
+
+.tt-audio-ambient .tt-audio-title {
+    font-size: 3.6vh;
+}
+
+.tt-audio-ambient .tt-audio-author {
+    font-size: 2.6vh;
+}
+
+.tt-audio-ambient-moving .tt-audio-content {
+    opacity: 0;
+}
+
+/* Portrait screens (phones): stack artwork above the details. */
+@media (max-aspect-ratio: 1/1) {
+    .tt-audio-content {
+        flex-direction: column;
+        text-align: center;
+        width: 88vw;
+    }
+
+    .tt-audio-art-wrap {
+        margin: 0 0 5vh;
+    }
+
+    .tt-audio-art {
+        width: 80vw;
+        height: 80vw;
+        border-radius: 3vw;
+    }
+
+    .tt-audio-info {
+        max-width: 88vw;
+        width: 100%;
+    }
+
+    .tt-audio-title { font-size: 3vh; }
+    .tt-audio-author { font-size: 2.2vh; }
+    .tt-audio-wave { height: 6vh; margin: 3vh 0 2.5vh; }
+    .tt-audio-wave span { width: 0.6vw; }
+    .tt-audio-btn { width: 9vh; height: 9vh; margin: 0 2vh; }
+    .tt-audio-btn-main { width: 11vh; height: 11vh; }
+    .tt-audio-hint { display: none; }
+    .tt-audio-weather { justify-content: center; flex-wrap: wrap; margin-bottom: 2.5vh; }
+    .tt-audio-weather-day { width: 14vw; margin: 0 1vw; }
+    .tt-audio-weather-city { width: 100%; margin: 1vh 0 0; text-align: center; }
+    .tt-audio-clock { font-size: calc(80vw / 52); margin: 0 auto 2vh; }
