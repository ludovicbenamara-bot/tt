+        bar.style.animationDelay = (-Math.random() * 1.2).toFixed(2) + 's';
+        els.wave.appendChild(bar);
+    }
+    info.appendChild(els.wave);
+
+    const progress = el('div', 'tt-audio-progress');
+    els.bar = el('div', 'tt-audio-bar');
+    els.fill = el('div', 'tt-audio-fill');
+    els.bar.appendChild(els.fill);
+    progress.appendChild(els.bar);
+    const times = el('div', 'tt-audio-times');
+    els.current = el('span');
+    els.badge = el('span', 'tt-audio-badge', t('player.audioOnly.badge'));
+    els.duration = el('span');
+    times.appendChild(els.current);
+    times.appendChild(els.badge);
+    times.appendChild(els.duration);
+    progress.appendChild(times);
+    info.appendChild(progress);
+
+    const controls = el('div', 'tt-audio-controls');
+    els.rewind = el('button', 'tt-audio-btn');
+    els.rewind.appendChild(svgIcon('tt-audio-icon', ICONS.back, String(SEEK_STEP)));
+    els.play = el('button', 'tt-audio-btn tt-audio-btn-main');
+    els.playIcon = svgIcon('tt-audio-icon', ICONS.pause);
+    els.play.appendChild(els.playIcon);
+    els.forward = el('button', 'tt-audio-btn');
+    els.forward.appendChild(svgIcon('tt-audio-icon', ICONS.forward, String(SEEK_STEP)));
+    els.rewind.addEventListener('click', () => seek(-SEEK_STEP));
+    els.play.addEventListener('click', togglePlay);
+    els.forward.addEventListener('click', () => seek(SEEK_STEP));
+    els.bar.addEventListener('click', (evt) => {
+        const video = getVideo();
+        const rect = els.bar.getBoundingClientRect();
+        if (!video || !rect.width || !isFinite(video.duration)) return;
+        video.currentTime = ((evt.clientX - rect.left) / rect.width) * video.duration;
+    });
+    els.previous = el('button', 'tt-audio-btn tt-audio-btn-track');
+    els.previous.appendChild(svgIcon('tt-audio-icon', ICONS.previous));
+    els.next = el('button', 'tt-audio-btn tt-audio-btn-track');
+    els.next.appendChild(svgIcon('tt-audio-icon', ICONS.next));
+    els.previous.addEventListener('click', previousTrack);
+    els.next.addEventListener('click', nextTrack);
+    controls.appendChild(els.previous);
+    controls.appendChild(els.rewind);
+    controls.appendChild(els.play);
+    controls.appendChild(els.forward);
+    controls.appendChild(els.next);
+    info.appendChild(controls);
+
+    content.appendChild(info);
+    overlay.appendChild(content);
+
+    const footer = el('div', 'tt-audio-footer');
+    footer.appendChild(el('span', 'tt-audio-hint', t('player.audioOnly.hint')));
+    els.exit = el('button', 'tt-audio-exit', t('player.audioOnly.exit'));
+    els.exit.addEventListener('click', () => disableAudioOnly('exit button'));
+    footer.appendChild(els.exit);
+    overlay.appendChild(footer);
+
+    els.burnIn = createBurnInGuard(overlay, content, footer);
+
+    document.body.appendChild(overlay);
+}
+
+function updateClock() {
+    els.clock.update();
+}
+
+function setPlayIcon(paused) {
+    const paths = paused ? ICONS.play : ICONS.pause;
+    while (els.playIcon.firstChild) els.playIcon.removeChild(els.playIcon.firstChild);
+    for (const d of paths) {
+        const path = document.createElementNS(SVG_NS, 'path');
+        path.setAttribute('d', d);
+        els.playIcon.appendChild(path);
+    }
+}
+
+// Prefer the HD thumbnail (16:9, no letterbox); not every video has one.
+function setArtwork(videoId) {
+    const hq = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
+    const hd = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
+    const apply = (url, letterboxed) => {
+        els.art.style.backgroundImage = `url("${url}")`;
+        els.art.classList.toggle('tt-audio-art-letterboxed', letterboxed);
+        els.backdrop.style.backgroundImage = `url("${url}")`;
+        els.backdrop2.style.backgroundImage = `url("${url}")`;
+    };
+    apply(hq, true);
+    const probe = new Image();
+    probe.onload = () => {
+        // YouTube answers missing HD thumbnails with a 120x90 placeholder.
+        if (probe.naturalWidth > 120 && lastVideoId === videoId) apply(hd, false);
+    };
+    probe.src = hd;
+}
+
+// On TV, getVideoData() often has no title/author, so remember the ones seen
+// in player responses (TizenTube already parses them through JSON.parse).
+const videoDetailsById = {};
+const origParse = JSON.parse;
+JSON.parse = function () {
+    const r = origParse.apply(this, arguments);
+    try {
+        const details = r && r.videoDetails;
+        if (details && details.videoId) {
+            videoDetailsById[details.videoId] = { title: details.title, author: details.author };
+        }
+    } catch (e) { }
+    return r;
+};
+
+function getTitleAndAuthor(player, data) {
+    let title = data.title;
+    let author = data.author;
+    if ((!title || !author) && player.getPlayerResponse) {
+        try {
+            const details = player.getPlayerResponse().videoDetails || {};
+            title = title || details.title;
+            author = author || details.author;
+        } catch (e) { }
+    }
+    // YouTube TV publishes the "now playing" info here (it is what Android
+    // shows for the media session), and it is the most reliable source on TV.
+    const metadata = navigator.mediaSession && navigator.mediaSession.metadata;
+    if (metadata) {
+        title = title || metadata.title;
+        author = author || metadata.artist;
+    }
+    const cached = videoDetailsById[data.video_id];
+    if (cached) {
+        title = title || cached.title;
+        author = author || cached.author;
+    }
+    return { title: title || '', author: author || '' };
+}
+
+function updateMetadata() {
+    const player = getPlayer();
+    const data = player && player.getVideoData ? player.getVideoData() : null;
+    if (!data) return;
+
+    const videoId = data.video_id;
+    const isNewVideo = videoId !== lastVideoId;
+
+    // Text can arrive after the video starts, so keep filling it while empty.
+    if (isNewVideo || !els.title.textContent || !els.author.textContent) {
+        const info = getTitleAndAuthor(player, data);
+        els.title.textContent = info.title;
+        els.author.textContent = info.author;
+    }
+
+    if (!isNewVideo) return;
+    lastVideoId = videoId;
+
+    if (videoId && VIDEO_ID_RE.test(videoId)) {
+        setArtwork(videoId);
+    } else {
+        els.art.style.removeProperty('background-image');
+        els.backdrop.style.removeProperty('background-image');
+        els.backdrop2.style.removeProperty('background-image');
+    }
+}
+
+function updateProgress() {
+    const video = getVideo();
+    if (!video) return;
+    const duration = video.duration;
+    const current = video.currentTime;
+    const ratio = isFinite(duration) && duration > 0 ? Math.min(current / duration, 1) : 0;
+
+    els.fill.style.width = `${ratio * 100}%`;
+    els.current.textContent = formatTime(current);
+    // Remaining time, as Apple Music shows it.
+    els.duration.textContent = isFinite(duration) ? '-' + formatTime(duration - current) : t('player.audioOnly.live');
