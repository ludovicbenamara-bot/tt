+    // (same approach as ui/ui.js).
+    const existingStyle = document.querySelector('style[nonce]');
+    if (existingStyle) {
+        existingStyle.textContent += css;
+    } else {
+        const style = el('style');
+        style.textContent = css;
+        document.head.appendChild(style);
+    }
+
+    overlay = el('div', 'tt-audio');
+    overlay.style.display = 'none';
+
+    // Two drifting copies of the blurred artwork, like Apple Music's animated background.
+    els.backdrop = el('div', 'tt-audio-backdrop');
+    els.backdrop2 = el('div', 'tt-audio-backdrop tt-audio-backdrop-2');
+    overlay.appendChild(els.backdrop);
+    overlay.appendChild(els.backdrop2);
+    overlay.appendChild(el('div', 'tt-audio-shade'));
+
+    const content = el('div', 'tt-audio-content');
+
+    const artWrap = el('div', 'tt-audio-art-wrap');
+
+    // Widget-style clock above the artwork.
+    els.clock = createClock();
+    artWrap.appendChild(els.clock.element);
+
+    els.art = el('div', 'tt-audio-art');
+    artWrap.appendChild(els.art);
+    content.appendChild(artWrap);
+
+    const info = el('div', 'tt-audio-info');
+    els.weather = createWeather(t('player.audioOnly.today'), (data) => {
+        // Today's conditions also go under the clock.
+        const today = data.days[0];
+        const kind = kindFor(today.code);
+        els.clock.setWeather(weatherIcon(kind), t('player.audioOnly.conditions.' + kind), today.max);
+    });
