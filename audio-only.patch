+        if (++missingTicks >= MAX_MISSING_TICKS) disableAudioOnly('player closed');
+        return;
+    }
+    missingTicks = 0;
+    updateClock();
+    els.weather.refresh();
+    updateMetadata();
+    updateProgress();
+}
+
+function togglePlay() {
+    const video = getVideo();
+    if (!video) return;
+    if (video.paused) video.play();
+    else video.pause();
+    updateProgress();
+}
+
+function seek(delta) {
+    const video = getVideo();
+    if (!video) return;
+    const max = isFinite(video.duration) ? video.duration : Infinity;
+    video.currentTime = Math.max(0, Math.min(video.currentTime + delta, max));
+    updateProgress();
+}
+
+// Our player bar button is drawn by YouTube TV but never receives real focus
+// nor fires its command: when it is "selected", the DOM focus falls back to the
+// watch page. So detect it ourselves: a Left/Right move from a real transport
+// button that lands on a non-button, while our label is shown on screen.
+const HOLE_FOCUS_MAX_AGE_MS = 8000;
+let holeFocusAt = 0;
+
+function isTransportButton(el) {
+    return !!(el && el.tagName && el.tagName.toLowerCase() === 'yt-button-container' && el.getAttribute('aria-label'));
+}
+
+function isLabelVisible(label) {
+    const nodes = document.body.getElementsByTagName('*');
+    for (let i = 0; i < nodes.length; i++) {
+        const node = nodes[i];
+        if (node.childElementCount === 0 && node.offsetParent !== null && node.textContent.trim() === label &&
+            !(overlay && overlay.contains(node))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+function trackFocus(evt) {
+    if (evt.type !== 'keydown' || window.isAudioOnly) return;
+    if (evt.keyCode === 37 || evt.keyCode === 39) {
+        const wasOnButton = isTransportButton(document.activeElement);
+        holeFocusAt = 0;
+        if (wasOnButton) {
+            setTimeout(() => {
+                holeFocusAt = isTransportButton(document.activeElement) ? 0 : Date.now();
+            }, 50);
+        }
+    } else if (evt.keyCode !== 13) {
+        holeFocusAt = 0;
+    }
+}
+
+function isAudioButtonFocused() {
+    if (!holeFocusAt || Date.now() - holeFocusAt > HOLE_FOCUS_MAX_AGE_MS) return false;
+    if (isTransportButton(document.activeElement)) return false;
+    return isLabelVisible(t('player.audioOnly.button'));
+}
+
+function currentVideoId() {
+    const player = getPlayer();
+    const data = player && player.getVideoData ? player.getVideoData() : null;
+    return data ? data.video_id : null;
+}
+
+function sendMediaKey(keyCode) {
+    for (const type of ['keydown', 'keyup']) {
+        const evt = document.createEvent('Event');
+        evt.initEvent(type, true, true);
+        evt.keyCode = keyCode;
+        evt.which = keyCode;
+        document.dispatchEvent(evt);
+    }
+}
+
+// Replays the media key YouTube TV handles natively; if the track has not
+// changed shortly after, falls back to the player API.
+function changeTrack(keyCode, apiName) {
+    const before = currentVideoId();
+    flashButton(keyCode === MEDIA_NEXT_KEY ? els.next : els.previous);
+    sendMediaKey(keyCode);
+    setTimeout(() => {
+        if (!window.isAudioOnly || currentVideoId() !== before) return;
+        const player = getPlayer();
+        if (player && typeof player[apiName] === 'function') {
+            log('media key had no effect, using', apiName);
+            try {
+                player[apiName]();
+            } catch (e) {
+                log(apiName, 'failed', e);
+            }
+        }
