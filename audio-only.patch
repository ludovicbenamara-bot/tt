+    // Red LED clock, then the 5-day forecast and the Swiss weather map.
+    els.clock = createLedClock();
+    artWrap.appendChild(els.clock.element);
+    els.weather = createWeather(t('player.audioOnly.today'), (data) => {
+        els.map.setCities(data.cities);
+    });
+    artWrap.appendChild(els.weather.element);
+    els.map = createSwissMap();
+    artWrap.appendChild(els.map.element);
+    content.appendChild(artWrap);
+
+    // Small artwork, next to the title.
+    els.art = el('div', 'tt-audio-art');
+
+    const info = el('div', 'tt-audio-info');
+
+    els.title = el('div', 'tt-audio-title');
+    els.author = el('div', 'tt-audio-author');
+    const titleRow = el('div', 'tt-audio-title-row');
+    const titleText = el('div', 'tt-audio-title-text');
+    titleText.appendChild(els.title);
+    titleText.appendChild(els.author);
+    titleRow.appendChild(els.art);
+    titleRow.appendChild(titleText);
+    info.appendChild(titleRow);
+
+    // Sound animation: Winamp-style LED spectrum analyser.
+    els.spectrum = createSpectrum();
+    info.appendChild(els.spectrum.element);
+
+    const progress = el('div', 'tt-audio-progress');
+    els.bar = el('div', 'tt-audio-bar');
+    els.fill = el('div', 'tt-audio-fill');
+    els.bar.appendChild(els.fill);
+    progress.appendChild(els.bar);
+    const times = el('div', 'tt-audio-times');
+    els.current = el('span');
+    els.badge = el('span', 'tt-audio-badge', t('player.audioOnly.badge'));
