+// Winamp-style LED spectrum analyser for the audio-only screen: columns of
+// LED segments on a dark dot matrix, white peak caps that hold then fall, and
+// a blue dotted baseline. The segments take the artwork's dominant colour
+// (green until one is found).
+// Cobalt plays sound through the TV's native player, so the page cannot
+// analyse it. The modified APK runs a small server on 127.0.0.1 that serves
+// Android's Visualizer spectrum of the output mix (YouTube's CSP allows
+// connect-src to localhost): while it answers, the bands follow the real
+// music. Otherwise they follow a simulated signal: a beat pulse, a bass-heavy
+// envelope and per-band noise, with fast attack and slow release.
+
+const BANDS = 24;
+const ROWS = 14;
+const FRAME_MS = 33;
+const GAP = 0.22;
+const PEAK_HOLD_MS = 450;
+const PEAK_FALL_PER_FRAME = 0.018;
+const ATTACK = 0.55;
+const RELEASE = 0.12;
+const SPECTRUM_URL = `http://127.0.0.1:47913/bands?n=${BANDS}&from=page`;
+const POLL_MS = 50;
+// Live data older than this is ignored (server gone, app paused...).
+const LIVE_MAX_AGE_MS = 600;
+// After a failed request, wait this long before trying again.
+const RETRY_MS = 5000;
+
+const COLORS = {
+    off: 'rgba(120, 140, 120, 0.16)',
+    low: [96, 196, 40],
+    high: [176, 240, 72],
+    peak: 'rgba(235, 240, 235, 0.95)',
+    base: 'rgba(80, 150, 255, 0.85)',
+};
+
+// HSL (0-360, 0-1, 0-1) -> [r, g, b] (0-255).
+function hslToRgb(h, s, l) {
+    const k = (n) => (n + h / 30) % 12;
+    const a = s * Math.min(l, 1 - l);
+    const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
+    return [Math.round(f(0) * 255), Math.round(f(8) * 255), Math.round(f(4) * 255)];
+}
+
+function rgbToHsv(r, g, b) {
+    const max = Math.max(r, g, b);
+    const min = Math.min(r, g, b);
+    const d = max - min;
+    let h = 0;
+    if (d) {
+        if (max === r) h = ((g - b) / d) % 6;
+        else if (max === g) h = (b - r) / d + 2;
+        else h = (r - g) / d + 4;
+        h = (h * 60 + 360) % 360;
+    }
+    return [h, max ? d / max : 0, max / 255];
+}
+
+// Dominant vivid hue of an image: pixels are grouped in 12 hue buckets,
+// weighted by saturation x brightness, and the strongest bucket wins.
+// Returns a hue (0-360), or null for a grey / unreadable image.
+function dominantHue(img) {
+    const W = 24;
+    const H = 18;
+    const canvas = document.createElement('canvas');
+    canvas.width = W;
+    canvas.height = H;
+    const c = canvas.getContext('2d');
+    // Skip the letterbox bars at the top and bottom of YouTube thumbnails.
+    const crop = img.naturalHeight * 0.125;
+    c.drawImage(img, 0, crop, img.naturalWidth, img.naturalHeight - crop * 2, 0, 0, W, H);
+    const data = c.getImageData(0, 0, W, H).data;
+    const weight = new Array(12).fill(0);
+    const hueSum = new Array(12).fill(0);
+    for (let i = 0; i < data.length; i += 4) {
+        const [h, sat, val] = rgbToHsv(data[i], data[i + 1], data[i + 2]);
+        const w = sat * sat * val;
+        if (w < 0.04) continue;
+        const bucket = Math.floor(h / 30) % 12;
+        weight[bucket] += w;
+        hueSum[bucket] += h * w;
+    }
+    let best = -1;
+    for (let b = 0; b < 12; b++) if (best < 0 || weight[b] > weight[best]) best = b;
+    if (best < 0 || weight[best] < 1) return null;
+    return hueSum[best] / weight[best];
+}
+
+function mix(a, b, t) {
+    return `rgb(${Math.round(a[0] + (b[0] - a[0]) * t)}, ${Math.round(a[1] + (b[1] - a[1]) * t)}, ${Math.round(a[2] + (b[2] - a[2]) * t)})`;
+}
+
+// Calls back with the artwork's LED colour [r, g, b], or null for grey art.
+export function colorFromImage(url, callback) {
+    const img = new Image();
+    img.crossOrigin = 'anonymous';
+    img.onload = () => {
+        let hue = null;
+        try {
+            hue = dominantHue(img);
+        } catch (e) { }
